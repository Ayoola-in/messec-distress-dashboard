# Copy to .env for local use. Never commit the real file.
MESSEC_ENV=development
# Required in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Empty means a local SQLite file. In production use your PostgreSQL URL.
DATABASE_URL=
# Shared key for beacons not yet linked to a citizen. Empty means only per-device keys work.
MESSEC_DEVICE_KEY=
# 1 turns on simulated signals and the demo banner. Keep 0 for real use.
MESSEC_SIMULATE=0
# Seconds before an unassigned critical signal goes to the nearest suitable station.
MESSEC_AUTO_ASSIGN_SECONDS=60
# Seconds before a station that hasn't accepted is flagged on the dashboard.
MESSEC_STATION_ACK_SECONDS=120
